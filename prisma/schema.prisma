generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}
enum ListingStatus {
  ACTIVE
  PAUSED
  DISABLED
}
enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}
enum SubscriptionStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELED
}
enum FutureProgram {
  INSURANCE
  TRACKER
}
enum FeePayer {
  RENTER
  OWNER
  SPLIT
}
enum PaymentStatus {
  UNPAID
  CHECKOUT_CREATED
  PAID
  FAILED
  REFUNDED
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String
  role Role @default(USER)
  isOwner Boolean @default(false)
  disabled Boolean @default(false)
  subscriptionStatus SubscriptionStatus @default(FREE)
  stripeCustomerId String? @unique
  stripeSubscriptionId String? @unique
  stripeConnectAccountId String? @unique
  stripeChargesEnabled Boolean @default(false)
  stripePayoutsEnabled Boolean @default(false)
  identityVerificationSessionId String? @unique
  identityVerificationStatus String @default("UNVERIFIED")
  identityVerifiedAt DateTime?
  subscriptionEndsAt DateTime?
  subscriptionPlan String?
  airtagBenefitStatus String @default("NOT_AVAILABLE")
  avatarUrl String?
  bio String?
  createdAt DateTime @default(now())
  listings Listing[]
  trips Booking[] @relation("RenterBookings")
  favorites Favorite[]
  sentMessages Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  reviews Review[]
  futureInterests FutureProgramInterest[]
  notifications Notification[]
  supportTickets SupportTicket[]
  savedSearches SavedSearch[]
}

model Listing {
  id String @id @default(cuid())
  slug String @unique
  title String
  description String
  category String
  location String
  pricePerDay Int
  securityDeposit Int @default(0)
  features String[]
  rules String[]
  deliveryOptions String[]
  details Json @default("{}")
  status ListingStatus @default(ACTIVE)
  insuranceStatus String @default("NOT_AVAILABLE")
  trackerStatus String @default("NOT_ENROLLED")
  feePayer FeePayer @default(RENTER)
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  photos Photo[]
  bookings Booking[]
  favorites Favorite[]
  reviews Review[]
  availabilityBlocks AvailabilityBlock[]
  verification VehicleVerification?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([category, location, status])
}

model Photo {
  id String @id @default(cuid())
  url String
  alt String?
  position Int @default(0)
  listingId String
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}
model Favorite {
  userId String
  listingId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, listingId])
}
model Booking {
  id String @id @default(cuid())
  listingId String
  renterId String
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  totalPrice Int
  subtotal Int @default(0)
  serviceFee Int @default(0)
  serviceFeeRate Int @default(1000)
  renterFee Int @default(0)
  ownerFee Int @default(0)
  ownerPayout Int @default(0)
  paymentStatus PaymentStatus @default(UNPAID)
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId String? @unique
  paidAt DateTime?
  status BookingStatus @default(PENDING)
  note String?
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  renter User @relation("RenterBookings", fields: [renterId], references: [id], onDelete: Cascade)
  messages Message[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([listingId, startDate, endDate, status])
}
model FutureProgramInterest {
  id String @id @default(cuid())
  program FutureProgram
  userId String
  listingId String @default("")
  consentAcknowledged Boolean @default(false)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([program, userId, listingId])
}
model Notification {
  id String @id @default(cuid())
  userId String
  type String
  title String
  body String
  href String?
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}
model AvailabilityBlock {
  id String @id @default(cuid())
  listingId String
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  note String?
  createdAt DateTime @default(now())
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@index([listingId, startDate, endDate])
}
model SupportTicket {
  id String @id @default(cuid())
  userId String
  subject String
  message String
  status String @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status, createdAt])
}
model VehicleVerification {
  id String @id @default(cuid())
  listingId String @unique
  status String @default("PENDING")
  vinLast4 String?
  registrationConfirmed Boolean @default(false)
  ownershipConfirmed Boolean @default(false)
  notes String?
  submittedAt DateTime @default(now())
  reviewedAt DateTime?
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}
model SavedSearch {
  id String @id @default(cuid())
  userId String
  name String
  query Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
model Message {
  id String @id @default(cuid())
  body String
  senderId String
  recipientId String
  bookingId String?
  sender User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([senderId, recipientId, createdAt])
}
model Review {
  id String @id @default(cuid())
  rating Int
  comment String
  authorId String
  listingId String
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([authorId, listingId])
}
