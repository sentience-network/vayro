generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}
enum ListingStatus {
  ACTIVE
  PAUSED
  DISABLED
}
enum BookingStatus {
  REQUESTED
  PENDING
  ACCEPTED
  PAYMENT_REQUIRED
  PAID
  ACTIVE
  DECLINED
  CANCELLED
  COMPLETED
  PAYMENT_FAILED
  REFUND_PENDING
  REFUNDED
  DISPUTED
}
enum SubscriptionStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELED
}
enum FutureProgram {
  INSURANCE
  TRACKER
}
enum FeePayer {
  RENTER
  OWNER
  SPLIT
}
enum PaymentStatus {
  UNPAID
  CHECKOUT_CREATED
  PAID
  FAILED
  REFUNDED
  REFUND_PENDING
  DISPUTED
}
enum InspectionType {
  CHECK_IN
  CHECK_OUT
}
enum CatalogSource {
  NHTSA
  USCG
  MANUFACTURER
  MANUAL
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String
  role Role @default(USER)
  isOwner Boolean @default(false)
  disabled Boolean @default(false)
  subscriptionStatus SubscriptionStatus @default(FREE)
  stripeCustomerId String? @unique
  stripeSubscriptionId String? @unique
  stripeConnectAccountId String? @unique
  stripeChargesEnabled Boolean @default(false)
  stripePayoutsEnabled Boolean @default(false)
  identityVerificationSessionId String? @unique
  identityVerificationStatus String @default("UNVERIFIED")
  identityVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  subscriptionEndsAt DateTime?
  subscriptionPlan String?
  airtagBenefitStatus String @default("NOT_AVAILABLE")
  avatarUrl String?
  bio String?
  createdAt DateTime @default(now())
  listings Listing[]
  trips Booking[] @relation("RenterBookings")
  favorites Favorite[]
  sentMessages Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  reviews Review[]
  futureInterests FutureProgramInterest[]
  notifications Notification[]
  supportTickets SupportTicket[]
  savedSearches SavedSearch[]
  analyticsEvents AnalyticsEvent[]
  policyAcceptances PolicyAcceptance[]
  emailDeliveries EmailDelivery[]
}

model Listing {
  id String @id @default(cuid())
  slug String @unique
  title String
  description String
  category String
  location String
  pricePerDay Int
  securityDeposit Int @default(0)
  features String[]
  rules String[]
  deliveryOptions String[]
  details Json @default("{}")
  status ListingStatus @default(ACTIVE)
  insuranceStatus String @default("NOT_AVAILABLE")
  trackerStatus String @default("NOT_ENROLLED")
  instantBook Boolean @default(false)
  deliveryRadiusMiles Int @default(0)
  deliveryBaseFee Int @default(0)
  deliveryPerMile Int @default(0)
  latitude Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  feePayer FeePayer @default(RENTER)
  ownerId String
  catalogModelId String?
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  catalogModel VehicleCatalogModel? @relation(fields: [catalogModelId], references: [id], onDelete: SetNull)
  photos Photo[]
  bookings Booking[]
  favorites Favorite[]
  reviews Review[]
  availabilityBlocks AvailabilityBlock[]
  verification VehicleVerification?
  inspections TripInspection[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([category, location, status])
  @@index([catalogModelId])
}

model VehicleCatalogMake {
  id String @id @default(cuid())
  source CatalogSource
  sourceId String
  name String
  normalizedName String
  vehicleTypes String[]
  country String?
  active Boolean @default(true)
  sourceUrl String
  lastSyncedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  models VehicleCatalogModel[]
  @@unique([source, sourceId])
  @@index([normalizedName])
  @@index([source, active])
}

model VehicleCatalogModel {
  id String @id @default(cuid())
  source CatalogSource
  sourceId String
  makeId String
  name String
  normalizedName String
  vehicleTypes String[]
  firstYear Int?
  lastYear Int?
  active Boolean @default(true)
  sourceUrl String
  lastSyncedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  make VehicleCatalogMake @relation(fields: [makeId], references: [id], onDelete: Cascade)
  listings Listing[]
  @@unique([source, sourceId])
  @@index([makeId, normalizedName])
  @@index([source, active])
}

model VehicleCatalogSync {
  id String @id @default(cuid())
  source CatalogSource
  status String @default("RUNNING")
  makesProcessed Int @default(0)
  modelsProcessed Int @default(0)
  error String?
  startedAt DateTime @default(now())
  completedAt DateTime?
  @@index([source, startedAt])
}

model Photo {
  id String @id @default(cuid())
  url String
  alt String?
  position Int @default(0)
  sourceUrl String?
  license String?
  providerAssetId String?
  uploadedByOwner Boolean @default(false)
  isRepresentative Boolean @default(false)
  listingId String
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}
model Favorite {
  userId String
  listingId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, listingId])
}
model Booking {
  id String @id @default(cuid())
  listingId String
  renterId String
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  totalPrice Int
  subtotal Int @default(0)
  serviceFee Int @default(0)
  serviceFeeRate Int @default(1000)
  renterFee Int @default(0)
  ownerFee Int @default(0)
  ownerPayout Int @default(0)
  paymentStatus PaymentStatus @default(UNPAID)
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId String? @unique
  paidAt DateTime?
  status BookingStatus @default(REQUESTED)
  cancellationReason String?
  cancelledAt DateTime?
  refundAmount Int @default(0)
  stripeRefundId String? @unique
  policyVersion String @default("2026-08-09")
  note String?
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  renter User @relation("RenterBookings", fields: [renterId], references: [id], onDelete: Cascade)
  messages Message[]
  inspections TripInspection[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([listingId, startDate, endDate, status])
}
model FutureProgramInterest {
  id String @id @default(cuid())
  program FutureProgram
  userId String
  listingId String @default("")
  consentAcknowledged Boolean @default(false)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([program, userId, listingId])
}
model Notification {
  id String @id @default(cuid())
  userId String
  type String
  title String
  body String
  href String?
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}
model AvailabilityBlock {
  id String @id @default(cuid())
  listingId String
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  note String?
  createdAt DateTime @default(now())
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@index([listingId, startDate, endDate])
}
model SupportTicket {
  id String @id @default(cuid())
  userId String
  subject String
  message String
  status String @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status, createdAt])
}
model VehicleVerification {
  id String @id @default(cuid())
  listingId String @unique
  status String @default("PENDING")
  vinLast4 String?
  registrationConfirmed Boolean @default(false)
  ownershipConfirmed Boolean @default(false)
  currentPhotosConfirmed Boolean @default(false)
  odometerOrHours Int?
  plateLast4 String?
  registrationDocumentRef String?
  ownershipDocumentRef String?
  documentProvider String?
  notes String?
  submittedAt DateTime @default(now())
  reviewedAt DateTime?
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model TripInspection {
  id String @id @default(cuid())
  type InspectionType
  bookingId String
  listingId String
  odometerOrHours Int?
  fuelOrBatteryLevel Int?
  notes String?
  damageDiagram Json @default("{}")
  renterConfirmedAt DateTime?
  ownerConfirmedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  photos InspectionPhoto[]
  @@unique([bookingId, type])
}

model InspectionPhoto {
  id String @id @default(cuid())
  inspectionId String
  url String
  providerAssetId String?
  capturedAt DateTime @default(now())
  inspection TripInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

model PolicyAcceptance {
  id String @id @default(cuid())
  userId String
  policy String
  version String
  acceptedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, policy, version])
}

model EmailDelivery {
  id String @id @default(cuid())
  userId String?
  toEmail String
  template String
  subject String
  status String @default("QUEUED")
  providerMessageId String?
  attempts Int @default(0)
  lastError String?
  payload Json @default("{}")
  createdAt DateTime @default(now())
  sentAt DateTime?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
}

model AnalyticsEvent {
  id String @id @default(cuid())
  userId String?
  sessionId String
  name String
  path String
  metadata Json @default("{}")
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([name, createdAt])
  @@index([sessionId, createdAt])
}
model SavedSearch {
  id String @id @default(cuid())
  userId String
  name String
  query Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
model Message {
  id String @id @default(cuid())
  body String
  senderId String
  recipientId String
  bookingId String?
  sender User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([senderId, recipientId, createdAt])
}
model Review {
  id String @id @default(cuid())
  rating Int
  comment String
  authorId String
  listingId String
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([authorId, listingId])
}
